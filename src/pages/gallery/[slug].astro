---
import PageLayout from "../../layouts/PageLayout.astro";
import { getImageBySlug, getAllImageSlugs } from "../../utils/getImages";
import { getMoonPhaseForDate } from "../../utils/moon";


export async function getStaticPaths() {
  const slugs = getAllImageSlugs();
  return slugs.map((slug) => ({
    params: { slug },
  }));
}


const { slug } = Astro.params;

const image = getImageBySlug(slug);

if (!slug) {
  return Astro.redirect("/projects/");
}

if (!image) {
  return Astro.redirect("/projects/");
}

const { frontmatter, Content } = image;

const moonData = (frontmatter.dates || []).map((dateStr) => ({
  date: new Date(dateStr).toLocaleDateString("en-GB", {
    year: "numeric",
    month: "short",
    day: "numeric",
  }),
  ...getMoonPhaseForDate(dateStr),
}));


const filters = frontmatter.filters || [];
const totalIntegration = filters.reduce((total, filter) => {
  const seconds = parseFloat(filter.exposureLength.replace('s', ''));
  return total + (isNaN(seconds) ? 0 : seconds * filter.exposureCount);
}, 0);

const hours = Math.floor(totalIntegration / 3600);
const minutes = Math.floor((totalIntegration % 3600) / 60);
const totalIntegrationStr = hours > 0 ? `${hours}h ${minutes}m` : `${minutes}m`;

---

<PageLayout title={frontmatter.title || ""}>

  <!-- Sidebar -->
  <div slot="sidebar">

    <!-- Object Information -->
    <div class="rounded-xl border border-space-700 bg-space-900 p-6 mb-6">
      <h3 class="text-lg font-bold text-starlight-200 mb-4">Object Information</h3>
      <dl class="space-y-2">
        {frontmatter.object && (
          <div class="flex justify-between">
            <dt class="text-starlight-400 text-sm">Object</dt>
            <dd class="text-starlight-100 text-sm font-medium">{frontmatter.object}</dd>
          </div>
        )}
        {frontmatter.type && (
          <div class="flex justify-between">
            <dt class="text-starlight-400 text-sm">Type</dt>
            <dd class="text-starlight-100 text-sm font-medium">{frontmatter.type}</dd>
          </div>
        )}
        {frontmatter.constellation && (
          <div class="flex justify-between">
            <dt class="text-starlight-400 text-sm">Constellation</dt>
            <dd class="text-starlight-100 text-sm font-medium">{frontmatter.constellation}</dd>
          </div>
        )}
      </dl>
    </div>

    <!-- Conditions -->
    <div class="rounded-xl border border-space-700 bg-space-900 p-6 mb-6">
      <h3 class="text-lg font-bold text-starlight-200 mb-4">Conditions</h3>
      <dl class="space-y-2">
        {frontmatter.location && (
          <div class="flex justify-between">
            <dt class="text-starlight-400 text-sm">Location</dt>
            <dd class="text-starlight-100 text-sm font-medium">{frontmatter.location}</dd>
          </div>
        )}
        {frontmatter.bortle && (
          <div class="flex justify-between">
            <dt class="text-starlight-400 text-sm">Bortle</dt>
            <dd class="text-starlight-100 text-sm font-medium">{frontmatter.bortle}</dd>
          </div>
        )}
        {frontmatter.temperature && (
          <div class="flex justify-between">
            <dt class="text-starlight-400 text-sm">Temperature</dt>
            <dd class="text-starlight-100 text-sm font-medium">{frontmatter.temperature}</dd>
          </div>
        )}
      </dl>

      <!-- Moon table -->
      {moonData.length > 0 && (
        <div class="mt-4">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-space-700">
                <th class="text-left text-starlight-400 pb-2">Date</th>
                <th class="text-right text-starlight-400 pb-2">Moon</th>
                <th class="text-right text-starlight-400 pb-2">Phase</th>
              </tr>
            </thead>
            <tbody>
              {moonData.map((night) => (
                <tr class="border-b border-space-700 last:border-0">
                  <td class="text-starlight-100 py-2">{night.date}</td>
                  <td class="text-aurora-500 text-right py-2">{night.illumination}%</td>
                  <td class="text-starlight-400 text-right py-2 text-xs">{night.phase}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>

    <!-- Equipment -->
    <div class="rounded-xl border border-space-700 bg-space-900 p-6 mb-6">
      <h3 class="text-lg font-bold text-starlight-200 mb-4">Equipment</h3>
      <dl class="space-y-2">
        {frontmatter.telescope && (
          <div class="flex justify-between">
            <dt class="text-starlight-400 text-sm">Telescope</dt>
            <dd class="text-starlight-100 text-sm font-medium text-right">{frontmatter.telescope}</dd>
          </div>
        )}
        {frontmatter.mount && (
          <div class="flex justify-between">
            <dt class="text-starlight-400 text-sm">Mount</dt>
            <dd class="text-starlight-100 text-sm font-medium text-right">{frontmatter.mount}</dd>
          </div>
        )}
        {frontmatter.camera && (
          <div class="flex justify-between">
            <dt class="text-starlight-400 text-sm">Camera</dt>
            <dd class="text-starlight-100 text-sm font-medium text-right">{frontmatter.camera}</dd>
          </div>
        )}
        {frontmatter.cameraTemperature && (
          <div class="flex justify-between">
            <dt class="text-starlight-400 text-sm">Camera Temp</dt>
            <dd class="text-starlight-100 text-sm font-medium">{frontmatter.cameraTemperature}</dd>
          </div>
        )}
      </dl>
    </div>

    <!-- Capture Details -->
    {filters.length > 0 && (
      <div class="rounded-xl border border-space-700 bg-space-900 p-6 mb-6">
        <h3 class="text-lg font-bold text-starlight-200 mb-4">Capture Details</h3>
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-space-700">
              <th class="text-left text-starlight-400 pb-2">Filter</th>
              <th class="text-right text-starlight-400 pb-2">Exp</th>
              <th class="text-right text-starlight-400 pb-2">No.</th>
              <th class="text-right text-starlight-400 pb-2">Bin</th>
            </tr>
          </thead>
          <tbody>
            {filters.map((filter) => (
              <tr class="border-b border-space-700 last:border-0">
                <td class="text-nebula-500 py-2">{filter.name}</td>
                <td class="text-starlight-100 text-right py-2">{filter.exposureLength}</td>
                <td class="text-starlight-100 text-right py-2">{filter.exposureCount}</td>
                <td class="text-starlight-100 text-right py-2">{filter.binning}</td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr class="border-t border-space-700">
              <td colspan="3" class="text-starlight-400 text-sm pt-2">Total Integration</td>
              <td class="text-aurora-500 font-bold text-right pt-2">{totalIntegrationStr}</td>
            </tr>
          </tfoot>
        </table>
      </div>
    )}

    <!-- Tags -->
    {frontmatter.tags && frontmatter.tags.length > 0 && (
      <div class="rounded-xl border border-space-700 bg-space-900 p-6">
        <h3 class="text-lg font-bold text-starlight-200 mb-4">Tags</h3>
        <div class="flex flex-wrap gap-2">
          {frontmatter.tags.map((tag) => (
            <span class="px-3 py-1 text-xs font-medium text-nebula-500 border border-nebula-500 rounded-full">
              #{tag}
            </span>
          ))}
        </div>
      </div>
    )}

  </div>

  <!-- Main content -->
  <div class="relative z-20 w-full">

    <!-- Title -->
    <h1 class="text-4xl font-bold text-starlight-100 sm:text-5xl mb-6">
      {frontmatter.title}
    </h1>

    <!-- Full size image with lightbox -->
    <a href={frontmatter.image} class="glightbox" data-glightbox={`title: ${frontmatter.title}`}>
      <img
        src={frontmatter.image}
        alt={frontmatter.title}
        class="w-full rounded-xl cursor-pointer hover:opacity-90 transition-opacity duration-300"
      />
    </a>

    <!-- Written content -->
    <div class="prose prose-invert prose-lg max-w-none mt-10
      prose-headings:text-starlight-100
      prose-p:text-starlight-400
      prose-a:text-nebula-500
      prose-a:no-underline
      hover:prose-a:text-nebula-300
      prose-strong:text-starlight-200
      prose-code:text-aurora-400
      prose-blockquote:border-nebula-500
      prose-blockquote:text-starlight-400
      prose-li:text-starlight-400
      prose-hr:border-space-700">
      <Content />
    </div>

  </div>

</PageLayout>