---
import PageLayout from "../../../layouts/PageLayout.astro";
import { getAllImages } from "../../../utils/getImages";
import GallerySideBar from "../../../components/GallerySideBar.astro";

export async function getStaticPaths() {
  const images = getAllImages();
  
  // Get all unique tags
  const tags = new Set<string>();
  images.forEach((image) => {
    (image.tags || []).forEach((tag) => tags.add(tag));
  });

  // Generate a page for each tag
  return Array.from(tags).map((tag) => ({
    params: { tag },
    props: {
      tag,
      images: images.filter((image) => image.tags?.includes(tag)),
    },
  }));
}

const { tag, images } = Astro.props;
---

<PageLayout title={`Images tagged: #${tag}`} description={`All images tagged with #${tag}`}>

  <!-- Sidebar -->
  <div slot="sidebar">
    <GallerySideBar />
  </div>

  <!-- Main content -->
  <div class="relative z-20 w-full">
    <h2 class="text-5xl font-bold tracking-tight text-starlight-100 sm:text-6xl mb-4">
      #{tag}
    </h2>
    <p class="text-lg text-starlight-400 mb-10">
      {images.length} {images.length === 1 ? 'image' : 'images'} tagged with <span class="text-nebula-500">#{tag}</span>
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {images.map((image) => (
        <a
          href={image.href}
          class="group relative flex flex-col rounded-2xl border border-space-700 bg-space-900 overflow-hidden hover:border-nebula-500 transition-all duration-300"
        >
          <div class="overflow-hidden">
            <img
              src={image.thumbnail || image.image}
              alt={image.title}
              class="w-full aspect-[16/9] object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="p-4">
            <h3 class="text-lg font-semibold text-starlight-100 group-hover:text-nebula-500 transition-colors">
              {image.title}
            </h3>
            <p class="mt-1 text-sm text-starlight-400">
              {image.type} · {image.constellation}
            </p>
            <p class="mt-1 text-sm text-aurora-500">
              {image.totalIntegration} total integration
            </p>
            {image.tags && image.tags.length > 0 && (
              <div class="flex flex-wrap gap-1 mt-3">
                {image.tags.map((t) => (
                  <span class="px-2 py-0.5 text-xs text-nebula-500 border border-nebula-500 rounded-full">
                    #{t}
                  </span>
                ))}
              </div>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>

</PageLayout>