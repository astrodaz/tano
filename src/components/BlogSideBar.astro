---
import { getAllPosts } from "../utils/getPosts";

const posts = getAllPosts();

// Build tag frequency map
const tagFrequency: Record<string, number> = {};
posts.forEach((post) => {
  (post.tags || []).forEach((tag) => {
    tagFrequency[tag] = (tagFrequency[tag] || 0) + 1;
  });
});

// Sort tags alphabetically
const tags = Object.entries(tagFrequency).sort(([a], [b]) => a.localeCompare(b));

// Get size class based on frequency
function getTagSize(count: number): string {
  if (count >= 7) return "text-xl";
  if (count >= 5) return "text-lg";
  if (count >= 3) return "text-base";
  return "text-sm";
}
---

<div class="rounded-xl border border-space-700 bg-space-900 p-6 mb-6">
  <h3 class="text-lg font-bold text-starlight-200 mb-4">Posts</h3>
  <ul class="space-y-2">
    <li>
      <a href="/posts/" class="text-starlight-400 hover:text-nebula-500 transition-colors">
        All Posts
      </a>
    </li>
  </ul>
</div>

<div class="rounded-xl border border-space-700 bg-space-900 p-6 mb-6">
  <h3 class="text-lg font-bold text-starlight-200 mb-4">Tags</h3>
  <div class="flex flex-wrap gap-2">
    {tags.map(([tag, count]) => (
      <a
        href={`/tags/${tag}/`}
        class={`${getTagSize(count)} text-nebula-500 hover:text-nebula-300 transition-colors border border-nebula-500 hover:border-nebula-300 rounded-full px-2 py-0.5`}
      >
        #{tag}
      </a>
    ))}
  </div>
</div>

<div class="rounded-xl border border-space-700 bg-space-900 p-6 mb-6">
  <h3 class="text-lg font-bold text-starlight-200 mb-4">Astronomy Links</h3>
  <ul class="space-y-2">
    <li>
      <a href="http://stargazerslounge.com" target="_blank" class="text-starlight-400 hover:text-nebula-500 transition-colors">
        Stargazers Lounge
      </a>
    </li>
    <li>
      <a href="http://bedsastro.org.uk" target="_blank" class="text-starlight-400 hover:text-nebula-500 transition-colors">
        Bedford AS
      </a>
    </li>
    <li>
      <a href="https://www.ldas.org.uk" target="_blank" class="text-starlight-400 hover:text-nebula-500 transition-colors">
        Letchworth & District AS
